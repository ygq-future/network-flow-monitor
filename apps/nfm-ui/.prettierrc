{
  "singleQuote": true,
  "semi": false,
  "trailingComma": "all",
  "printWidth": 120,
  "tabWidth": 2,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "bracketSpacing": true,
  "bracketSameLine": true,
  "tailwindStylesheet": "./src/app/index.css",
  "plugins": ["prettier-plugin-tailwindcss"]
}
