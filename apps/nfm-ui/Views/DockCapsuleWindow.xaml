<Window x:Class="NetworkFlowMonitor.Views.DockCapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetworkFlowMonitor Capsule"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Width="16"
        Height="64">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Visible Capsule Pill -->
        <Border x:Name="CapsulePill"
                Width="10"
                Height="64"
                HorizontalAlignment="Right"
                VerticalAlignment="Stretch"
                CornerRadius="5"
                Background="#D918181B"
                BorderBrush="#40FFFFFF"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Download Track (Top half, scaling downwards) -->
                <Grid Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                    <Rectangle x:Name="DownloadFillRect"
                               Height="0"
                               VerticalAlignment="Top"
                               HorizontalAlignment="Stretch">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#19D8E6" Offset="0.0" />
                                <GradientStop Color="#2878D0" Offset="0.5" />
                                <GradientStop Color="#8146B8" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>

                <!-- Upload Track (Bottom half, scaling upwards) -->
                <Grid Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                    <Rectangle x:Name="UploadFillRect"
                               Height="0"
                               VerticalAlignment="Bottom"
                               HorizontalAlignment="Stretch">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Color="#F4D03F" Offset="0.0" />
                                <GradientStop Color="#F39C32" Offset="0.5" />
                                <GradientStop Color="#D93636" Offset="1.0" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
