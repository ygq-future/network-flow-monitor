<Window x:Class="NetworkFlowMonitor.Views.DockCapsuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NetworkFlowMonitor Capsule"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Width="10"
        Height="64">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="5"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Visible Capsule Pill: Fixed Layout Size (10 x 64 DIP, Perfectly Symmetrical 5 DIP Radius Pill) -->
        <Border x:Name="CapsulePill"
                Width="10"
                Height="64"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                CornerRadius="5"
                Background="#B0141418"
                BorderThickness="0"
                ClipToBounds="True"
                RenderTransformOrigin="0.5,0.5">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270" Color="#000000" Opacity="0.35" />
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="CapsulePillTranslate" X="0" Y="0" />
                    <ScaleTransform x:Name="CapsulePillScale" ScaleX="1" ScaleY="1" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="32" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <!-- Download Track (Top half: Fixed Height 32, CornerRadius 5) -->
                <Grid Grid.Row="0" VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="32" ClipToBounds="True">
                    <Border x:Name="DownloadFillRect"
                            Height="0"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush x:Name="DownloadGradientBrush" StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="DlStop0" Color="#19D8E6" Offset="0.0" />
                                <GradientStop x:Name="DlStop1" Color="#2878D0" Offset="0.5" />
                                <GradientStop x:Name="DlStop2" Color="#8146B8" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>

                <!-- Upload Track (Bottom half: Fixed Height 32, CornerRadius 5) -->
                <Grid Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="32" ClipToBounds="True">
                    <Border x:Name="UploadFillRect"
                            Height="0"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Stretch"
                            CornerRadius="5">
                        <Border.Background>
                            <LinearGradientBrush x:Name="UploadGradientBrush" StartPoint="0,1" EndPoint="0,0">
                                <GradientStop x:Name="UlStop0" Color="#F4D03F" Offset="0.0" />
                                <GradientStop x:Name="UlStop1" Color="#F39C32" Offset="0.5" />
                                <GradientStop x:Name="UlStop2" Color="#D93636" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
