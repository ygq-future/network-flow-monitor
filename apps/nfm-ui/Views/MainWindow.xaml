<Window x:Class="NetworkFlowMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Flow Monitor"
        Height="220"
        Width="380"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Network Flow Monitor"
                       FontWeight="SemiBold"
                       FontSize="16"
                       VerticalAlignment="Center"/>
            <Border x:Name="StatusBadge"
                    DockPanel.Dock="Right"
                    Background="#27272A"
                    CornerRadius="4"
                    Padding="8,2">
                <TextBlock x:Name="StatusText"
                           Text="Disconnected"
                           FontSize="12"
                           Foreground="#A1A1AA"/>
            </Border>
        </DockPanel>

        <!-- Rates Display -->
        <Grid Grid.Row="1" Margin="0,4,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Download Card -->
            <Border Grid.Column="0"
                    Background="#27272A"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="↓ DOWNLOAD"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#19D8E6"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="DownloadRateText"
                               Text="0.0 B/s"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>

            <!-- Upload Card -->
            <Border Grid.Column="2"
                    Background="#27272A"
                    CornerRadius="8"
                    Padding="12">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="↑ UPLOAD"
                               FontSize="11"
                               FontWeight="Bold"
                               Foreground="#F39C32"
                               Margin="0,0,0,4"/>
                    <TextBlock x:Name="UploadRateText"
                               Text="0.0 B/s"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer Diagnostics -->
        <DockPanel Grid.Row="2">
            <TextBlock x:Name="SeqText"
                       Text="Seq: 0"
                       FontSize="11"
                       Foreground="#71717A"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="InstanceText"
                       DockPanel.Dock="Right"
                       Text="Instance: None"
                       FontSize="11"
                       Foreground="#71717A"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
