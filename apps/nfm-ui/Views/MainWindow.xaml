<Window x:Class="NetworkFlowMonitor.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Flow Monitor"
        Height="420"
        Width="400"
        MinHeight="360"
        MinWidth="380"
        WindowStartupLocation="CenterScreen"
        Background="#18181B"
        Foreground="#F4F4F5"
        FontFamily="Segoe UI Variable Text, Segoe UI, sans-serif">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Network Flow Monitor"
                       FontWeight="SemiBold"
                       FontSize="16"
                       VerticalAlignment="Center"/>
            <Border x:Name="StatusBadge"
                    DockPanel.Dock="Right"
                    Background="#27272A"
                    CornerRadius="4"
                    Padding="8,2">
                <TextBlock x:Name="StatusText"
                           Text="Disconnected"
                           FontSize="12"
                           Foreground="#A1A1AA"/>
            </Border>
        </DockPanel>

        <!-- Aggregate Rates Display (4 Hz) -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Download Card -->
            <Border Grid.Column="0"
                    Background="#27272A"
                    CornerRadius="8"
                    Padding="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="↓ TOTAL DOWNLOAD"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#19D8E6"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="DownloadRateText"
                               Text="0 B/s"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>

            <!-- Upload Card -->
            <Border Grid.Column="2"
                    Background="#27272A"
                    CornerRadius="8"
                    Padding="10">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="↑ TOTAL UPLOAD"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="#F39C32"
                               Margin="0,0,0,2"/>
                    <TextBlock x:Name="UploadRateText"
                               Text="0 B/s"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="#FFFFFF"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Top N Applications Ranking List (1 Hz) -->
        <Border Grid.Row="2"
                Background="#202023"
                CornerRadius="8"
                BorderBrush="#2E2E32"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,2,4,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="APPLICATION" FontSize="10" FontWeight="Bold" Foreground="#71717A"/>
                    <TextBlock Grid.Column="1" Text="DOWNLOAD" FontSize="10" FontWeight="Bold" Foreground="#19D8E6" TextAlignment="Right"/>
                    <TextBlock Grid.Column="2" Text="UPLOAD" FontSize="10" FontWeight="Bold" Foreground="#F39C32" TextAlignment="Right"/>
                </Grid>

                <!-- Status Placeholder (Warm-up / Idle / Offline) -->
                <TextBlock x:Name="RankingStatusText"
                           Grid.Row="1"
                           Text="Collecting data…"
                           FontSize="13"
                           Foreground="#A1A1AA"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed"/>

                <!-- Ranking Rows -->
                <ItemsControl x:Name="RankingItemsList" Grid.Row="1">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#27272A" CornerRadius="4" Margin="0,2" Padding="6,4">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               FontSize="12"
                                               Foreground="#F4F4F5"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding ExecutablePath}"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding DownloadRateText}"
                                               FontSize="12"
                                               FontFamily="Consolas, Segoe UI Variable Text, monospace"
                                               Foreground="#E4E4E7"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding UploadRateText}"
                                               FontSize="12"
                                               FontFamily="Consolas, Segoe UI Variable Text, monospace"
                                               Foreground="#E4E4E7"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- Footer Diagnostics -->
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="SeqText"
                       Text="Seq: 0"
                       FontSize="11"
                       Foreground="#71717A"
                       VerticalAlignment="Center"/>
            <TextBlock x:Name="DiagnosticsText"
                       DockPanel.Dock="Right"
                       Text="Instance: None"
                       FontSize="11"
                       Foreground="#71717A"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Grid>
</Window>
