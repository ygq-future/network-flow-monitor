<Window x:Class="NetworkFlowMonitor.Views.MonitorPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Flow Monitor"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Width="340"
        SizeToContent="Height">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="HeaderRateTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,8,0" />
        </Style>
    </Window.Resources>

    <Border x:Name="PanelCard"
            CornerRadius="8"
            Background="#A618181C"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="5"
            SnapsToDevicePixels="True">
        <StackPanel Orientation="Vertical">
            <!-- Header Row (36 DIP) -->
            <Grid Height="36" Margin="4,0,4,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Product Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="14" Height="14"
                          Data="M2,7 L5,2 L9,12 L12,7 L14,7"
                          Stroke="#38BDF8" StrokeThickness="1.5"
                          VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Network Flow Monitor"
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="12" FontWeight="SemiBold"
                               Foreground="#E4E4E7" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Total Download Rate -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="10" Height="10"
                          Data="M5,1 L5,8 M2,5 L5,8 L8,5"
                          Stroke="#38BDF8" StrokeThickness="1.5"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderDownloadText" Text="0 B/s"
                               Style="{StaticResource HeaderRateTextStyle}" />
                </StackPanel>

                <!-- Total Upload Rate -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="10" Height="10"
                          Data="M5,8 L5,1 M2,4 L5,1 L8,4"
                          Stroke="#F59E0B" StrokeThickness="1.5"
                          VerticalAlignment="Center" />
                    <TextBlock x:Name="HeaderUploadText" Text="0 B/s"
                               Style="{StaticResource HeaderRateTextStyle}" />
                </StackPanel>
            </Grid>

            <!-- Status Row / Ranking Row List -->
            <Grid x:Name="ContentArea">
                <!-- Status Row -->
                <Border x:Name="StatusRow"
                        Height="28"
                        Visibility="Visible"
                        Padding="8,0"
                        VerticalAlignment="Center">
                    <TextBlock x:Name="StatusRowText"
                               Text="正在采集数据…"
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="12"
                               Foreground="#A1A1AA"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left" />
                </Border>

                <!-- Ranking Rows -->
                <ItemsControl x:Name="RankingItemsControl" Visibility="Collapsed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="28" Margin="4,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>

                                <!-- App Icon Placeholder -->
                                <Border Grid.Column="0" Width="16" Height="16"
                                        CornerRadius="3" Background="#33FFFFFF"
                                        VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="⚡" FontSize="9"
                                               Foreground="#E4E4E7"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <!-- App Name -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding DisplayName}"
                                           FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                           FontSize="12"
                                           Foreground="#F4F4F5"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis"
                                           Margin="0,0,8,0" />

                                <!-- Download Rate -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DownloadRateText}"
                                           FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                           FontSize="12"
                                           Foreground="#38BDF8"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />

                                <!-- Upload Rate -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding UploadRateText}"
                                           FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                           FontSize="12"
                                           Foreground="#F59E0B"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </StackPanel>
    </Border>
</Window>
