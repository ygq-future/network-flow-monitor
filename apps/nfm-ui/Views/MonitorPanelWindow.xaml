<Window x:Class="NetworkFlowMonitor.Views.MonitorPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Flow Monitor"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Width="340"
        Height="74"
        MaxHeight="520">
    <Window.Resources>
        <Style x:Key="HeaderRateTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F4F4F5" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
    </Window.Resources>

    <!-- 50% Opacity Deep Dark Glass Card (0x80 = 128 Alpha) -->
    <Grid x:Name="RootGrid" Background="Transparent">
        <Border x:Name="PanelCard"
                CornerRadius="8"
                Background="#80101014"
                BorderBrush="#38FFFFFF"
                BorderThickness="1"
                Padding="6,4"
                SnapsToDevicePixels="True"
                RenderTransformOrigin="1.0,0.0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.45" />
            </Border.Effect>
            <Border.RenderTransform>
                <TransformGroup>
                    <TranslateTransform x:Name="PanelCardTranslate" X="0" Y="0" />
                    <ScaleTransform x:Name="PanelCardScale" ScaleX="1" ScaleY="1" />
                </TransformGroup>
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Pinned Header Row (36 DIP) -->
                <Grid Grid.Row="0" Margin="4,0,4,0" SnapsToDevicePixels="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="75" />
                        <ColumnDefinition Width="75" />
                    </Grid.ColumnDefinitions>

                    <!-- Brand: Untranslated "Network Flow Monitor" -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Width="14" Height="14"
                              Data="M2,7 L5,2 L9,12 L12,7 L14,7"
                              Stroke="#38BDF8" StrokeThickness="1.5"
                              VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Network Flow Monitor"
                                   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FFFFFF" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Total Download Rate -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Path Width="10" Height="10"
                              Data="M5,1 L5,8 M2,5 L5,8 L8,5"
                              Stroke="#38BDF8" StrokeThickness="1.5"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderDownloadText" Text="0 B/s"
                                   Style="{StaticResource HeaderRateTextStyle}" />
                    </StackPanel>

                    <!-- Total Upload Rate -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <Path Width="10" Height="10"
                              Data="M5,8 L5,1 M2,4 L5,1 L8,4"
                              Stroke="#F59E0B" StrokeThickness="1.5"
                              VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderUploadText" Text="0 B/s"
                                   Style="{StaticResource HeaderRateTextStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Content Area: Status Row or Virtualized Ranking List -->
                <Grid Grid.Row="1" x:Name="ContentArea">
                    <!-- Status Row -->
                    <Border x:Name="StatusRow"
                            Height="28"
                            Visibility="Visible"
                            Padding="8,0"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="StatusRowText"
                                   Text="正在采集数据…"
                                   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                   FontSize="12"
                                   Foreground="#CCCCCC"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left" />
                    </Border>

                    <!-- Ranking Rows Viewport (Zero Scrollbars) -->
                    <ScrollViewer x:Name="RankingScrollViewer"
                                  Visibility="Collapsed"
                                  VerticalScrollBarVisibility="Disabled"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Focusable="False">
                        <ItemsControl x:Name="RankingItemsControl">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="28" Margin="4,0" SnapsToDevicePixels="True" Opacity="{Binding Opacity}">
                                        <Grid.RenderTransform>
                                            <TranslateTransform Y="{Binding TranslateY}" />
                                        </Grid.RenderTransform>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="75" />
                                            <ColumnDefinition Width="75" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Async Extracted / Fallback Icon (Fixed 16x16 geometry box) -->
                                        <Image Grid.Column="0"
                                               Source="{Binding Icon}"
                                               Width="16" Height="16"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Left"
                                               RenderOptions.BitmapScalingMode="HighQuality" />

                                        <!-- Application Name (Ellipsized) -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding DisplayName}"
                                                   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                                   FontSize="12"
                                                   Foreground="#F4F4F5"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="2,0,8,0" />

                                        <!-- Download Rate -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DownloadRateText}"
                                                   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                                   FontSize="12"
                                                   Foreground="#38BDF8"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />

                                        <!-- Upload Rate -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding UploadRateText}"
                                                   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                                                   FontSize="12"
                                                   Foreground="#F59E0B"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
