<Window x:Class="NetworkFlowMonitor.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Network Flow Monitor - Settings"
        Width="720"
        Height="540"
        MinWidth="520"
        MinHeight="420"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
        FontSize="13">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40"
                      CornerRadius="8"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="4" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/NetworkFlowMonitor;component/Resources/FluentStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Nav Button Style -->
            <Style x:Key="FluentNavRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Margin" Value="6,2,6,2" />
                <Setter Property="Padding" Value="12,0,12,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Active Indicator Bar -->
                                    <Rectangle x:Name="ActiveIndicator"
                                               Width="3"
                                               Height="16"
                                               RadiusX="1.5"
                                               RadiusY="1.5"
                                               Fill="{DynamicResource AccentTextBrush}"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Margin="-8,0,0,0"
                                               Visibility="Collapsed" />

                                    <ContentPresenter Grid.Column="0"
                                                      x:Name="ContentSite"
                                                      ContentSource="Content"
                                                      RecognizesAccessKey="True"
                                                      VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="#18FFFFFF" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="RootBorder" Property="Background" Value="#25FFFFFF" />
                                    <Setter TargetName="ActiveIndicator" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Setting Card Style -->
            <Style x:Key="FluentCardBorderStyle" TargetType="Border">
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Background" Value="#12FFFFFF" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,14" />
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- Fluent Standard Button Style -->
            <Style x:Key="FluentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#18FFFFFF" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#2AFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#12FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Fluent Accent Button Style -->
            <Style x:Key="FluentAccentButtonStyle" TargetType="Button">
                <Setter Property="Background" Value="#0284C7" />
                <Setter Property="Foreground" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#0369A1" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="16,7" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="ButtonBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"
                                    Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#0369A1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="#075985" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Window Caption Button Style -->
            <Style x:Key="CaptionButtonStyle" TargetType="Button">
                <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="32" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#25FFFFFF" />
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#15FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Close Caption Button Style -->
            <Style x:Key="CloseCaptionButtonStyle" TargetType="Button" BasedOn="{StaticResource CaptionButtonStyle}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="0,8,0,0" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#E81123" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="Background" Value="#C4101E" />
                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer Acrylic Card Container (Rounded 8px with DWM hardware clipping) -->
    <Border x:Name="SettingsRoot"
            CornerRadius="8"
            Background="#E618181C"
            BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Fluent Titlebar / Caption Header -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnTitleBarMouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Window Brand & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Image x:Name="AppHeaderIcon" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="Network Flow Monitor" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window Caption Controls (Minimize, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top">
                    <Button Style="{StaticResource CaptionButtonStyle}" Content="—" Click="OnMinimizeClicked" ToolTip="最小化" />
                    <Button Style="{StaticResource CloseCaptionButtonStyle}" Content="✕" Click="OnCloseClicked" ToolTip="关闭" />
                </StackPanel>
            </Grid>

            <!-- Main Content: Sidebar + Content Panels -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SidebarColumn" Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left Navigation Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SettingsSidebarBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="0,0,1,0"
                        CornerRadius="0,0,0,8"
                        SnapsToDevicePixels="True">
                    <Grid Margin="0,8,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Navigation Radio Button Group -->
                        <StackPanel Grid.Row="0">
                            <!-- Tab 0: General -->
                            <RadioButton x:Name="NavGeneralButton"
                                         GroupName="NavTabs"
                                         Style="{StaticResource FluentNavRadioButtonStyle}"
                                         IsChecked="{Binding SelectedTabIndex, ConverterParameter=0, Mode=OneWay}"
                                         Click="OnNavGeneralClick"
                                         ToolTip="{Binding GeneralTabHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14"
                                          Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="NavGeneralLabel" Text="{Binding GeneralTabHeader}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Tab 1: Monitor (Includes Ranking TopN) -->
                            <RadioButton x:Name="NavMonitorButton"
                                         GroupName="NavTabs"
                                         Style="{StaticResource FluentNavRadioButtonStyle}"
                                         IsChecked="{Binding SelectedTabIndex, ConverterParameter=1, Mode=OneWay}"
                                         Click="OnNavMonitorClick"
                                         ToolTip="{Binding MonitorTabHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14"
                                          Data="M21,16H3V4H21V16M21,2H3C1.89,2 1,2.89 1,4V16A2,2 0 0,0 3,18H10V20H8V22H16V20H14V18H21A2,2 0 0,0 23,16V4C23,2.89 22.1,2 21,2Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="NavMonitorLabel" Text="{Binding MonitorTabHeader}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Tab 2: Collector -->
                            <RadioButton x:Name="NavCollectorButton"
                                         GroupName="NavTabs"
                                         Style="{StaticResource FluentNavRadioButtonStyle}"
                                         IsChecked="{Binding SelectedTabIndex, ConverterParameter=2, Mode=OneWay}"
                                         Click="OnNavCollectorClick"
                                         ToolTip="{Binding CollectorTabHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14"
                                          Data="M4,1H20A1,1 0 0,1 21,2V6A1,1 0 0,1 20,7H4A1,1 0 0,1 3,6V2A1,1 0 0,1 4,1M4,9H20A1,1 0 0,1 21,10V14A1,1 0 0,1 20,15H4A1,1 0 0,1 3,14V10A1,1 0 0,1 4,9M4,17H20A1,1 0 0,1 21,18V22A1,1 0 0,1 20,23H4A1,1 0 0,1 3,22V18A1,1 0 0,1 4,17M9,5H10V3H9V5M9,13H10V11H9V13M9,21H10V19H9V21M5,3V5H7V3H5M5,11V13H7V11H5M5,19V21H7V19H5Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="NavCollectorLabel" Text="{Binding CollectorTabHeader}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <!-- Tab 3: Diagnostics -->
                            <RadioButton x:Name="NavDiagnosticsButton"
                                         GroupName="NavTabs"
                                         Style="{StaticResource FluentNavRadioButtonStyle}"
                                         IsChecked="{Binding SelectedTabIndex, ConverterParameter=3, Mode=OneWay}"
                                         Click="OnNavDiagnosticsClick"
                                         ToolTip="{Binding DiagnosticsTabHeader}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="14" Height="14"
                                          Data="M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3M19,19H5V5H19V19M7,7H9V9H7V7M7,11H9V13H7V11M7,15H9V17H7V15M11,7H17V9H11V7M11,11H17V13H11V11M11,15H17V17H11V15Z"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                          VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <TextBlock x:Name="NavDiagnosticsLabel" Text="{Binding DiagnosticsTabHeader}" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Sidebar Footer Version -->
                        <TextBlock x:Name="SidebarFooterText"
                                   Grid.Row="1"
                                   Text="{Binding AppVersion, StringFormat='v{0}'}"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4" />
                    </Grid>
                </Border>

                <!-- Content Area -->
                <TabControl Grid.Column="1"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <!-- Tab 0: General Settings -->
                    <TabItem>
                        <ScrollViewer Style="{StaticResource FluentScrollViewerStyle}" Padding="28,20,28,24">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding GeneralTabHeader}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16" />

                                <!-- Language Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding LanguageLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Style="{StaticResource FluentComboBoxStyle}"
                                                  ItemsSource="{Binding LanguageOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedLanguage}" />
                                    </Grid>
                                </Border>

                                <!-- Theme Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ThemeLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Style="{StaticResource FluentComboBoxStyle}"
                                                  ItemsSource="{Binding ThemeOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding SelectedTheme}" />
                                    </Grid>
                                </Border>

                                <!-- Start With Windows Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StartWithWindowsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  IsChecked="{Binding StartWithWindows}"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 1: Monitor & Ranking Settings -->
                    <TabItem>
                        <ScrollViewer Style="{StaticResource FluentScrollViewerStyle}" Padding="28,20,28,24">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding MonitorTabHeader}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16" />

                                <!-- Auto-Hide Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding AutoHideLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding AutoHideEnabled}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Pinned Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding PinnedLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding Pinned}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Capsule Width Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CapsuleWidthLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="8 - 24 DIP" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Width="140" Minimum="8" Maximum="24" SmallChange="1" LargeChange="2" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding CapsuleWidthDip}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CapsuleWidthDip, StringFormat='{}{0} DIP'}" Width="56" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Capsule Height Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CapsuleHeightLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="40 - 160 DIP" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Width="140" Minimum="40" Maximum="160" SmallChange="4" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="2" Value="{Binding CapsuleHeightDip}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CapsuleHeightDip, StringFormat='{}{0} DIP'}" Width="56" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Hover Delay Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HoverDelayLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="100 - 2000 ms" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Width="140" Minimum="100" Maximum="2000" SmallChange="50" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="50" Value="{Binding HoverDelayMs}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding HoverDelayMs, StringFormat='{}{0} ms'}" Width="56" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Dismiss Delay Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DismissDelayLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="100 - 2000 ms" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Width="140" Minimum="100" Maximum="2000" SmallChange="50" LargeChange="100" IsSnapToTickEnabled="True" TickFrequency="50" Value="{Binding DismissDelayMs}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding DismissDelayMs, StringFormat='{}{0} ms'}" Width="56" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Panel Opacity Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PanelOpacityLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="10% - 100%" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Width="140" Minimum="0.1" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding PanelOpacity}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding PanelOpacity, StringFormat='{}{0:P0}'}" Width="56" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Blur Strength Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding BlurStrengthLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="0% - 100%" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Width="140" Minimum="0.0" Maximum="1.0" SmallChange="0.05" LargeChange="0.1" Value="{Binding BlurStrength}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding BlurStrength, StringFormat='{}{0:P0}'}" Width="56" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Yield Fullscreen Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TopmostYieldLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <CheckBox Grid.Column="1" IsChecked="{Binding YieldFullscreen}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Rate Units Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding RateUnitsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1"
                                                  Style="{StaticResource FluentComboBoxStyle}"
                                                  ItemsSource="{Binding RateUnitOptions}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding RateUnits}" />
                                    </Grid>
                                </Border>

                                <!-- Top N Application Count Card (Merged into Monitor tab) -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding TopNLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="1 - 20" FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Slider Width="140" Minimum="1" Maximum="20" SmallChange="1" LargeChange="5" IsSnapToTickEnabled="True" TickFrequency="1" Value="{Binding TopN}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding TopN}" Width="36" TextAlignment="Right" FontSize="12" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Collector Information & Controls -->
                    <TabItem>
                        <ScrollViewer Style="{StaticResource FluentScrollViewerStyle}" Padding="28,20,28,24">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding CollectorTabHeader}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16" />

                                <!-- Connection State Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ConnectionStateLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ConnectionStateText}" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Collector PID Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding CollectorPidLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CollectorPid}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Instance ID Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding InstanceIdLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding CollectorInstanceId}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="240" />
                                    </Grid>
                                </Border>

                                <!-- ETW Health Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding EtwHealthLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding EtwSessionActiveText}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Dropped Packets Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DroppedPacketsLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding DroppedPackets}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Active Process Count Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding ActivePidsLabel}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding ActivePids}" Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Actions Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{Binding RetryCollectorLabel}"
                                                Command="{Binding RetryCollectorCommand}"
                                                Style="{StaticResource FluentButtonStyle}"
                                                Margin="0,0,8,0" />
                                        <Button Content="{Binding RestartCollectorLabel}"
                                                Command="{Binding RestartCollectorCommand}"
                                                Style="{StaticResource FluentButtonStyle}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: Diagnostics -->
                    <TabItem>
                        <ScrollViewer Style="{StaticResource FluentScrollViewerStyle}" Padding="28,20,28,24">
                            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                                <TextBlock Text="{Binding DiagnosticsTabHeader}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,16" />

                                <!-- Summary Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <StackPanel>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding AppVersionLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding AppVersion}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Grid>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ProtocolVersionLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ProtocolVersion}" Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Grid>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding ConfigPathLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ConfigFilePath}" Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="280" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Copy Diagnostics Card -->
                                <Border Style="{StaticResource FluentCardBorderStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding CopyDiagnosticsLabel}" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
                                            <TextBlock Text="{Binding CopyStatusText}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="{Binding CopyDiagnosticsLabel}"
                                                Command="{Binding CopyDiagnosticsCommand}"
                                                Style="{StaticResource FluentAccentButtonStyle}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
    </Border>
</Window>
