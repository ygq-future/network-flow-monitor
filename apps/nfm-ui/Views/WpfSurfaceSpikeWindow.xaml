<Window x:Class="NetworkFlowMonitor.Views.WpfSurfaceSpikeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WPF Surface Spike (Windows 11 Acceptance)"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="Transparent"
        Width="660"
        Height="460"
        WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="0"
                      GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False"
                      NonClientFrameEdges="None"
                      ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>
    <!-- Root Container: Pure translucent overlay over DWM backdrop -->
    <Border x:Name="SpikeRoot"
            CornerRadius="10"
            Background="#12FFFFFF"
            BorderBrush="#33FFFFFF"
            BorderThickness="1"
            Padding="18"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title & Header -->
            <Grid Grid.Row="0" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="WPF Window Surface Spike (Windows 11)"
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="16" FontWeight="SemiBold" Foreground="#F4F4F5" />
                    <TextBlock Text="验证 WindowStyle=None, AllowsTransparency=False, DWM 硬件合成亚克力/云母材质与圆角"
                               FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                               FontSize="11" Foreground="#A1A1AA" Margin="0,2,0,0" />
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1" Content="✕" Width="28" Height="28"
                        Background="#20FFFFFF" Foreground="#A1A1AA"
                        BorderThickness="0" Cursor="Hand"
                        VerticalAlignment="Top" Click="OnCloseClicked">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="14" />
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>

            <!-- Content Area -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="200" />
                </Grid.ColumnDefinitions>

                <!-- Left Column: Controls & Live Logs -->
                <Grid Grid.Column="0" Margin="0,0,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- DWM Backdrop Selector -->
                    <Border Grid.Row="0" CornerRadius="6" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DWM 系统材质 (System Backdrop)" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioAcrylic" Content="Acrylic (亚克力)" Foreground="#F4F4F5" FontSize="11" IsChecked="True" Checked="OnBackdropChanged" Margin="0,0,12,0" />
                                <RadioButton x:Name="RadioMica" Content="Mica (云母)" Foreground="#F4F4F5" FontSize="11" Checked="OnBackdropChanged" Margin="0,0,12,0" />
                                <RadioButton x:Name="RadioNone" Content="None (关闭)" Foreground="#F4F4F5" FontSize="11" Checked="OnBackdropChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- DWM Corner Preference -->
                    <Border Grid.Row="1" CornerRadius="6" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="DWM 窗口圆角 (Corner Preference)" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="RadioRound" Content="Round (标准圆角)" Foreground="#F4F4F5" FontSize="11" IsChecked="True" Checked="OnCornerChanged" Margin="0,0,12,0" />
                                <RadioButton x:Name="RadioSmallRound" Content="Small Round (微圆角)" Foreground="#F4F4F5" FontSize="11" Checked="OnCornerChanged" Margin="0,0,12,0" />
                                <RadioButton x:Name="RadioSquare" Content="Square (直角)" Foreground="#F4F4F5" FontSize="11" Checked="OnCornerChanged" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Live Diagnostics Log -->
                    <Border Grid.Row="2" CornerRadius="6" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="实时检测诊断日志" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7" Margin="2,0,0,4" />
                            <TextBox x:Name="LogTextBox" Grid.Row="1"
                                     FontFamily="Consolas, Cascadia Code, monospace"
                                     FontSize="11"
                                     Background="#20000000"
                                     Foreground="#34D399"
                                     BorderBrush="#25FFFFFF"
                                     BorderThickness="1"
                                     Padding="6"
                                     IsReadOnly="True"
                                     VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right Column: Capsule Pill & Hit Area Preview -->
                <Border Grid.Column="1" CornerRadius="6" Background="#15FFFFFF" BorderBrush="#20FFFFFF" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="胶囊与命中区预览" FontSize="11" FontWeight="SemiBold" Foreground="#E4E4E7" HorizontalAlignment="Center" Margin="0,0,0,8" />

                        <!-- Center Canvas for Capsule Demo -->
                        <Grid Grid.Row="1" Background="#18000000">
                            <!-- Inward Hit Target (>= 16 DIP) -->
                            <Border x:Name="HitTargetBox"
                                    Width="32" Height="140"
                                    HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="#2538BDF8"
                                    BorderBrush="#6038BDF8"
                                    BorderThickness="1"
                                    ToolTip="内向命中扩展区域 (>= 16 DIP)">
                                <!-- Visible 10 DIP Capsule Pill -->
                                <Border x:Name="SpikeCapsulePill"
                                        Width="10" Height="140"
                                        HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                        CornerRadius="5"
                                        Background="#8018181B"
                                        BorderBrush="#80FFFFFF"
                                        BorderThickness="1"
                                        ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <!-- Download Fill -->
                                        <Rectangle Height="45" VerticalAlignment="Top" HorizontalAlignment="Stretch">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                    <GradientStop Color="#19D8E6" Offset="0.0" />
                                                    <GradientStop Color="#2878D0" Offset="0.5" />
                                                    <GradientStop Color="#8146B8" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <!-- Upload Fill -->
                                        <Rectangle Height="30" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Stretch">
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                    <GradientStop Color="#F4D03F" Offset="0.0" />
                                                    <GradientStop Color="#F39C32" Offset="0.5" />
                                                    <GradientStop Color="#D93636" Offset="1.0" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Bottom Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="运行自动化检测"
                        Background="#3B82F6" Foreground="#FFFFFF"
                        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                        FontSize="11" FontWeight="SemiBold"
                        Padding="14,6" BorderThickness="0" Cursor="Hand"
                        Margin="0,0,8,0" Click="OnRunChecksClicked">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </Button.Resources>
                </Button>
                <Button Content="关闭"
                        Background="#25FFFFFF" Foreground="#F4F4F5"
                        FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
                        FontSize="11"
                        Padding="14,6" BorderThickness="0" Cursor="Hand"
                        Click="OnCloseClicked">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
